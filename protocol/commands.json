{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexmarathon.local/protocol/v1/commands.json",
  "title": "CodexMarathon protocol v1 controller-to-runtime commands",
  "description": "JSON-RPC requests and typed result payloads for the controller/runtime boundary. Method names are intentionally namespaced and stable on the wire; the display names match the architecture document.",
  "oneOf": [
    { "$ref": "#/$defs/NegotiateVersionRequest" },
    { "$ref": "#/$defs/GetRuntimeStateRequest" },
    { "$ref": "#/$defs/PrepareAuthTransitionRequest" },
    { "$ref": "#/$defs/CommitAuthTransitionRequest" },
    { "$ref": "#/$defs/CancelAuthTransitionRequest" },
    { "$ref": "#/$defs/GetIdentityRequest" },
    { "$ref": "#/$defs/GetAuthGenerationRequest" }
  ],
  "$defs": {
    "request_id": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "request_base": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "NegotiateVersionRequest": {
      "title": "NegotiateVersion",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "protocol/negotiate" },
        "params": { "$ref": "#/$defs/NegotiateVersionParams" }
      },
      "additionalProperties": false
    },
    "NegotiateVersionParams": {
      "type": "object",
      "required": ["supported_versions"],
      "properties": {
        "supported_versions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "NegotiateVersionResult": {
      "type": "object",
      "required": ["protocol_version", "server_versions"],
      "properties": {
        "protocol_version": { "type": "integer", "minimum": 1 },
        "server_versions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "GetRuntimeStateRequest": {
      "title": "GetRuntimeState",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "runtime/state/read" },
        "params": { "const": {} }
      },
      "additionalProperties": false
    },
    "RuntimeIdentity": {
      "type": "object",
      "required": ["runtime_id", "account_id", "auth_generation"],
      "properties": {
        "runtime_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": ["string", "null"] },
        "auth_generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "PendingTransition": {
      "type": "object",
      "required": ["transition_id", "target_account_id", "expected_generation"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "target_account_id": { "type": "string", "minLength": 1 },
        "expected_generation": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "GetRuntimeStateResult": {
      "type": "object",
      "required": ["identity", "active_turn_count", "pending_transition"],
      "properties": {
        "identity": { "$ref": "#/$defs/RuntimeIdentity" },
        "active_turn_count": { "type": "integer", "minimum": 0 },
        "pending_transition": {
          "anyOf": [
            { "$ref": "#/$defs/PendingTransition" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "PrepareAuthTransitionRequest": {
      "title": "PrepareAuthTransition",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "auth/transition/prepare" },
        "params": { "$ref": "#/$defs/AuthTransitionParams" }
      },
      "additionalProperties": false
    },
    "CommitAuthTransitionRequest": {
      "title": "CommitAuthTransition",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "auth/transition/commit" },
        "params": { "$ref": "#/$defs/AuthTransitionParams" }
      },
      "additionalProperties": false
    },
    "CancelAuthTransitionRequest": {
      "title": "CancelAuthTransition",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "auth/transition/cancel" },
        "params": { "$ref": "#/$defs/CancelAuthTransitionParams" }
      },
      "additionalProperties": false
    },
    "AuthTransitionParams": {
      "type": "object",
      "required": ["transition_id", "target_account_id", "expected_generation"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "target_account_id": { "type": "string", "minLength": 1 },
        "expected_generation": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "CancelAuthTransitionParams": {
      "type": "object",
      "required": ["transition_id", "expected_generation"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "expected_generation": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "TransitionOutcome": {
      "type": "string",
      "enum": ["committed", "rejected", "uncertain"]
    },
    "TransitionResult": {
      "type": "object",
      "required": ["transition_id", "runtime_id", "auth_generation", "outcome", "account_id"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "runtime_id": { "type": "string", "minLength": 1 },
        "auth_generation": { "type": "integer", "minimum": 0 },
        "outcome": { "$ref": "#/$defs/TransitionOutcome" },
        "account_id": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "GetIdentityRequest": {
      "title": "GetIdentity",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "runtime/identity/read" },
        "params": { "const": {} }
      },
      "additionalProperties": false
    },
    "GetAuthGenerationRequest": {
      "title": "GetAuthGeneration",
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "runtime/authGeneration/read" },
        "params": { "const": {} }
      },
      "additionalProperties": false
    },
    "AuthGenerationResult": {
      "type": "object",
      "required": ["auth_generation"],
      "properties": {
        "auth_generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "CommandResult": {
      "description": "The result member of a successful JSON-RPC response. Select the matching result definition by request method.",
      "oneOf": [
        { "$ref": "#/$defs/NegotiateVersionResult" },
        { "$ref": "#/$defs/GetRuntimeStateResult" },
        { "$ref": "#/$defs/TransitionResult" },
        { "$ref": "#/$defs/RuntimeIdentity" },
        { "$ref": "#/$defs/AuthGenerationResult" }
      ]
    },
    "method_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "wire_method"],
        "properties": {
          "name": { "type": "string" },
          "wire_method": { "type": "string" }
        },
        "additionalProperties": false
      },
      "default": [
        { "name": "GetRuntimeState", "wire_method": "runtime/state/read" },
        { "name": "PrepareAuthTransition", "wire_method": "auth/transition/prepare" },
        { "name": "CommitAuthTransition", "wire_method": "auth/transition/commit" },
        { "name": "CancelAuthTransition", "wire_method": "auth/transition/cancel" },
        { "name": "GetIdentity", "wire_method": "runtime/identity/read" },
        { "name": "GetAuthGeneration", "wire_method": "runtime/authGeneration/read" },
        { "name": "NegotiateVersion", "wire_method": "protocol/negotiate" }
      ]
    }
  }
}
