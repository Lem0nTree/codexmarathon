{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexmarathon.local/protocol/v1/protocol.json",
  "title": "CodexMarathon protocol v1 JSON-RPC envelope",
  "description": "The transport-neutral envelope for CodexMarathon controller/runtime IPC. Messages are newline-delimited JSON objects when carried over a stream.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/notification" },
    { "$ref": "#/$defs/success_response" },
    { "$ref": "#/$defs/error_response" }
  ],
  "$defs": {
    "request_id": {
      "description": "A JSON-RPC request identifier. The Go client emits strings; integers remain valid for interoperability.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "jsonrpc": {
      "const": "2.0"
    },
    "params": {
      "type": "object",
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/params" }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "method": {
          "const": "codexmarathon/event"
        },
        "params": {
          "type": "object",
          "required": ["event_type"],
          "additionalProperties": true
        }
      },
      "not": { "required": ["id"] },
      "additionalProperties": false
    },
    "success_response": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "id": { "$ref": "#/$defs/request_id" },
        "result": {}
      },
      "not": { "required": ["error", "method"] },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string", "minLength": 1 },
        "data": {}
      },
      "additionalProperties": false
    },
    "error_response": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "id": { "$ref": "#/$defs/request_id" },
        "error": { "$ref": "#/$defs/error" }
      },
      "not": { "required": ["result", "method"] },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "description": "The runtime's observed identity. A null account_id means that the runtime is currently unauthenticated or cannot identify the account.",
      "required": ["runtime_id", "account_id", "auth_generation"],
      "properties": {
        "runtime_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": ["string", "null"] },
        "auth_generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "transition_identity": {
      "type": "object",
      "description": "Fields required on every event that is part of an authentication transition.",
      "required": ["transition_id", "runtime_id", "auth_generation"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "runtime_id": { "type": "string", "minLength": 1 },
        "auth_generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
