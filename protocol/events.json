{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexmarathon.local/protocol/v1/events.json",
  "title": "CodexMarathon protocol v1 runtime-to-controller events",
  "description": "Typed event parameters carried in the codexmarathon/event JSON-RPC notification. Common correlation fields are snake_case; rate-limit payload members preserve the upstream app-server camelCase names.",
  "oneOf": [
    { "$ref": "#/$defs/RuntimeReady" },
    { "$ref": "#/$defs/RateLimitsSnapshot" },
    { "$ref": "#/$defs/RateLimitsUpdated" },
    { "$ref": "#/$defs/TurnStarted" },
    { "$ref": "#/$defs/TurnCompleted" },
    { "$ref": "#/$defs/SafeBoundaryReached" },
    { "$ref": "#/$defs/AuthReloadStarted" },
    { "$ref": "#/$defs/AuthReloadSucceeded" },
    { "$ref": "#/$defs/AuthReloadFailed" },
    { "$ref": "#/$defs/IdentityChanged" },
    { "$ref": "#/$defs/RecoveryParked" },
    { "$ref": "#/$defs/RecoveryStarted" },
    { "$ref": "#/$defs/RecoveryCompleted" }
  ],
  "$defs": {
    "EventBase": {
      "type": "object",
      "required": ["event_type", "occurred_at", "runtime_id", "auth_generation"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "integer", "minimum": 0 },
        "runtime_id": { "type": "string", "minLength": 1 },
        "auth_generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "TransitionFields": {
      "type": "object",
      "required": ["transition_id", "runtime_id", "auth_generation"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "runtime_id": { "type": "string", "minLength": 1 },
        "auth_generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "RateLimitWindow": {
      "type": "object",
      "required": ["usedPercent", "windowDurationMins", "resetsAt"],
      "properties": {
        "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "windowDurationMins": { "type": ["integer", "null"], "minimum": 1 },
        "resetsAt": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "RateLimitSnapshot": {
      "type": "object",
      "required": ["limitId", "limitName", "planType", "rateLimitReachedType", "primary", "secondary"],
      "properties": {
        "limitId": { "type": ["string", "null"] },
        "limitName": { "type": ["string", "null"] },
        "planType": { "type": ["string", "null"] },
        "rateLimitReachedType": { "type": ["string", "null"] },
        "primary": {
          "anyOf": [
            { "$ref": "#/$defs/RateLimitWindow" },
            { "type": "null" }
          ]
        },
        "secondary": {
          "anyOf": [
            { "$ref": "#/$defs/RateLimitWindow" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "RuntimeReady": {
      "title": "RuntimeReady",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "protocol_version", "account_id"],
          "properties": {
            "event_type": { "const": "runtime_ready" },
            "protocol_version": { "type": "integer", "minimum": 1 },
            "account_id": { "type": ["string", "null"] },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "RateLimitsSnapshot": {
      "title": "RateLimitsSnapshot",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "account_id", "rateLimits", "rateLimitsByLimitId"],
          "properties": {
            "event_type": { "const": "rate_limits_snapshot" },
            "account_id": { "type": ["string", "null"] },
            "rateLimits": { "$ref": "#/$defs/RateLimitSnapshot" },
            "rateLimitsByLimitId": {
              "type": ["object", "null"],
              "additionalProperties": { "$ref": "#/$defs/RateLimitSnapshot" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "RateLimitsUpdated": {
      "title": "RateLimitsUpdated",
      "description": "A sparse rolling update. The controller must merge it against the runtime connection's latest full snapshot or refetch; null metadata does not clear prior values.",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "account_id", "rateLimits"],
          "properties": {
            "event_type": { "const": "rate_limits_updated" },
            "account_id": { "type": ["string", "null"] },
            "rateLimits": { "$ref": "#/$defs/RateLimitSnapshot" }
          },
          "additionalProperties": true
        }
      ]
    },
    "TurnStarted": {
      "title": "TurnStarted",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "turn_id"],
          "properties": {
            "event_type": { "const": "turn_started" },
            "turn_id": { "type": "string", "minLength": 1 },
            "thread_id": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "TurnCompleted": {
      "title": "TurnCompleted",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "turn_id", "outcome"],
          "properties": {
            "event_type": { "const": "turn_completed" },
            "turn_id": { "type": "string", "minLength": 1 },
            "thread_id": { "type": ["string", "null"] },
            "outcome": { "type": "string", "enum": ["completed", "failed", "interrupted"] },
            "error_code": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "SafeBoundaryReached": {
      "title": "SafeBoundaryReached",
      "description": "Emitted only after Codext's authoritative running-turn guard reaches a safe boundary.",
      "allOf": [
        { "$ref": "#/$defs/TransitionFields" },
        {
          "type": "object",
          "required": ["event_type", "occurred_at", "transition_id", "reason"],
          "properties": {
            "event_type": { "const": "safe_boundary_reached" },
            "occurred_at": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string", "minLength": 1 },
            "turn_id": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "AuthReloadStarted": {
      "title": "AuthReloadStarted",
      "allOf": [
        { "$ref": "#/$defs/TransitionFields" },
        {
          "type": "object",
          "required": ["event_type", "occurred_at", "transition_id", "target_account_id"],
          "properties": {
            "event_type": { "const": "auth_reload_started" },
            "occurred_at": { "type": "integer", "minimum": 0 },
            "target_account_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "AuthReloadSucceeded": {
      "title": "AuthReloadSucceeded",
      "allOf": [
        { "$ref": "#/$defs/TransitionFields" },
        {
          "type": "object",
          "required": ["event_type", "occurred_at", "transition_id", "account_id", "changed"],
          "properties": {
            "event_type": { "const": "auth_reload_succeeded" },
            "occurred_at": { "type": "integer", "minimum": 0 },
            "account_id": { "type": ["string", "null"] },
            "previous_account_id": { "type": ["string", "null"] },
            "changed": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      ]
    },
    "AuthReloadFailed": {
      "title": "AuthReloadFailed",
      "allOf": [
        { "$ref": "#/$defs/TransitionFields" },
        {
          "type": "object",
          "required": ["event_type", "occurred_at", "transition_id", "error_code", "error_message"],
          "properties": {
            "event_type": { "const": "auth_reload_failed" },
            "occurred_at": { "type": "integer", "minimum": 0 },
            "error_code": { "type": "string", "minLength": 1 },
            "error_message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "IdentityChanged": {
      "title": "IdentityChanged",
      "allOf": [
        { "$ref": "#/$defs/TransitionFields" },
        {
          "type": "object",
          "required": ["event_type", "occurred_at", "transition_id", "previous_account_id", "account_id"],
          "properties": {
            "event_type": { "const": "identity_changed" },
            "occurred_at": { "type": "integer", "minimum": 0 },
            "previous_account_id": { "type": ["string", "null"] },
            "account_id": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "RecoveryParked": {
      "title": "RecoveryParked",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "recovery_id", "reason"],
          "properties": {
            "event_type": { "const": "recovery_parked" },
            "recovery_id": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "RecoveryStarted": {
      "title": "RecoveryStarted",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "recovery_id"],
          "properties": {
            "event_type": { "const": "recovery_started" },
            "recovery_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "RecoveryCompleted": {
      "title": "RecoveryCompleted",
      "allOf": [
        { "$ref": "#/$defs/EventBase" },
        {
          "type": "object",
          "required": ["event_type", "recovery_id", "outcome"],
          "properties": {
            "event_type": { "const": "recovery_completed" },
            "recovery_id": { "type": "string", "minLength": 1 },
            "outcome": { "type": "string", "enum": ["completed", "failed", "skipped"] },
            "error_code": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
