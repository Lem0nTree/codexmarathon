{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MarathonAccount": {
      "description": "Secret-free view of one account managed by the native Marathon service.",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "alias": {
          "type": "string"
        },
        "credentialHealth": {
          "type": "string"
        },
        "credentialPresent": {
          "type": "boolean"
        },
        "resetActionAvailable": {
          "default": false,
          "description": "Whether the provider reported an immediate quota-reset action for this account. This is capability metadata, never an inferred timestamp.",
          "type": "boolean"
        },
        "weeklyQuotaRemainingPercent": {
          "default": null,
          "description": "Last native provider observation for the weekly/long quota window. `null` means the provider has not supplied a weekly window yet.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "accountId",
        "active",
        "alias",
        "credentialHealth",
        "credentialPresent"
      ],
      "type": "object"
    }
  },
  "description": "Status of the in-process Marathon account manager.\n\nThis type intentionally contains identity and lifecycle metadata only. It must never grow fields containing auth snapshots or token material.",
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/definitions/MarathonAccount"
      },
      "type": "array"
    },
    "activeAccountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "activeTurnCount": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "authGeneration": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "autoResetEnabled": {
      "default": false,
      "type": "boolean"
    },
    "autoResetLastError": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "autoResetPhase": {
      "default": "",
      "type": "string"
    },
    "currentAccountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "accounts",
    "activeTurnCount",
    "authGeneration",
    "enabled"
  ],
  "title": "MarathonStatusResponse",
  "type": "object"
}